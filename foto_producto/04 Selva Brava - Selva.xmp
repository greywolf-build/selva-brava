   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Para bosque, vegetacion y producto en naturaleza. Verdes salvia apagados, sombras abiertas de sotobosque, bruma suave. Los verdes nunca a neon.</rdf:li>
    </rdf:Alt>
   </crs:Description>
