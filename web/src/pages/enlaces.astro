---
import Layout from '../layouts/Layout.astro';
import wordmark from '../assets/logo/wordmark-v-cream.svg';
import isotipo from '../assets/logo/isotipo-salvia.svg';
import grano from '../assets/images/grano-carbon.jpg';

const MERCADOLIBRE =
  'https://www.mercadolibre.com.ar/up/MLAU2977910815?matt_tool=89488245&pdp_filters=item_id:MLA2002373762';
const WHATSAPP =
  'https://wa.me/59899814711?text=' +
  encodeURIComponent('Hola! Quiero consultar por Selva Brava.');

const enlaces = [
  {
    href: MERCADOLIBRE,
    titulo: 'Comprar en Mercado Libre',
    nota: 'Sunscreen SPF 60 · envío a todo el país',
    tipo: 'primario',
  },
  {
    href: '/inicio',
    titulo: 'Conocé la marca',
    nota: 'Historia, producto y misión',
    tipo: 'claro',
  },
  {
    href: WHATSAPP,
    titulo: 'Escribinos por WhatsApp',
    nota: 'Del otro lado hay una persona',
    tipo: 'contorno',
  },
];
---

<Layout title="Selva Brava — Enlaces">
  <section class="hub">
    <div class="grano" style={`background-image:url(${grano.src});`}></div>

    <div class="contenido">
      <div class="marca anim" style="--d:0.05s">
        <img src={isotipo.src} alt="" class="halo" width="360" height="360" />
        <img src={wordmark.src} alt="Selva Brava" class="wordmark" width="360" height="352" />
      </div>

      <p class="linea anim" style="--d:0.25s">Protección solar orgánica</p>

      <nav class="lista">
        {enlaces.map((e, i) => (
          <a
            href={e.href}
            class={`link link-${e.tipo} anim`}
            style={`--d:${0.4 + i * 0.12}s`}
            target={e.href.startsWith('http') ? '_blank' : undefined}
            rel={e.href.startsWith('http') ? 'noopener' : undefined}
          >
            <span class="link-tit">{e.titulo}</span>
            <span class="link-nota">{e.nota}</span>
          </a>
        ))}
      </nav>

      <p class="pie anim" style="--d:0.85s">@selva.brava · AR / UY</p>
    </div>
  </section>
</Layout>

<style>
  .hub {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: radial-gradient(115% 90% at 50% 18%, #7F8D8B 0%, #687978 48%, #566462 100%);
    isolation: isolate;
  }
  .grano {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0.35;
    mix-blend-mode: soft-light;
    pointer-events: none;
  }

  .contenido {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 26rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.1rem;
    padding: 2.5rem 1.5rem;
  }

  .marca {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(200px, 62vw, 260px);
    aspect-ratio: 1;
  }
  .halo { grid-area: 1 / 1; width: 100%; height: auto; opacity: 0.6; }
  .wordmark {
    grid-area: 1 / 1;
    position: relative;
    z-index: 1;
    width: 52%;
    height: auto;
    filter: drop-shadow(0 6px 20px rgba(30, 37, 35, 0.35));
  }

  .linea {
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.24em;
    color: rgba(250, 248, 241, 0.82);
    margin: 0 0 0.4rem;
  }

  .lista {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .link {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.95rem 1.25rem;
    border-radius: 3px;
    text-decoration: none;
    transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 8px 22px rgba(30, 37, 35, 0.18);
  }
  .link:hover { transform: translateY(-2px); box-shadow: 0 12px 28px rgba(30, 37, 35, 0.26); }
  .link-tit {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 1.05rem;
  }
  .link-nota {
    font-family: "Barlow", sans-serif;
    font-size: 0.8rem;
  }

  /* Botón principal — Mercado Libre (bosque) */
  .link-primario { background: #4C6759; color: #FAF8F1; }
  .link-primario:hover { background: #435A4E; }
  .link-primario .link-nota { color: rgba(250, 248, 241, 0.72); }

  /* Botón claro — Web (salvia) */
  .link-claro { background: #A9B59D; color: #1E2523; }
  .link-claro:hover { background: #C5CCBA; }
  .link-claro .link-nota { color: rgba(30, 37, 35, 0.7); }

  /* Botón contorno — WhatsApp */
  .link-contorno {
    background: rgba(250, 248, 241, 0.06);
    color: #FAF8F1;
    box-shadow: inset 0 0 0 1px rgba(250, 248, 241, 0.35);
  }
  .link-contorno:hover { background: rgba(250, 248, 241, 0.14); box-shadow: inset 0 0 0 1px rgba(250, 248, 241, 0.55); }
  .link-contorno .link-nota { color: rgba(250, 248, 241, 0.7); }

  .pie {
    margin: 0.6rem 0 0;
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: rgba(169, 181, 157, 0.6);
  }

  .anim {
    opacity: 0;
    transform: translateY(14px);
    animation: rise 0.8s cubic-bezier(0.2, 0.65, 0.2, 1) forwards;
    animation-delay: var(--d, 0s);
  }
  @keyframes rise { to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .anim { animation: none; opacity: 1; transform: none; }
  }
</style>
