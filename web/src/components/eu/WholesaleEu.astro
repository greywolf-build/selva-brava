---
import { Image } from 'astro:assets';
import mayoristaImg from '../../assets/images/mayorista-surf.webp';
import { WHATSAPP } from '../../config/eu';

// Consulta temprana, no venta: el producto todavía no tiene registro europeo.
const WHATSAPP_B2B =
  WHATSAPP + '?text=' +
  encodeURIComponent("Hi! I'm interested in stocking Selva Brava in Europe.");
---

<section id="stockists" class="bg-terracota-100 py-20 md:py-28">
  <div class="mx-auto max-w-site px-6 md:px-10">
    <div class="grid items-center gap-10 md:grid-cols-2 md:gap-16">
      <figure class="reveal order-last overflow-hidden rounded-sm md:order-first">
        <Image
          src={mayoristaImg}
          alt="Surfer applying Selva Brava on the beach, next to their board"
          class="w-full object-cover"
          widths={[600, 1200]}
          sizes="(min-width: 768px) 45vw, 90vw"
        />
      </figure>
      <div>
        <p class="eyebrow reveal mb-4">Stockists</p>
        <h2 class="h-display reveal max-w-xl text-3xl text-carbon md:text-4xl">
          Run a shop, studio or distribution?
        </h2>
        <p class="reveal reveal-delay-1 mt-5 max-w-2xl text-[1.02rem] leading-relaxed text-slate-800">
          We're opening the conversation with wellness shops, outdoor stores, ski
          resorts and conscious boutiques across Europe. We're not shipping here yet —
          this is an early enquiry, so we know where to start when we do. Clear terms,
          no small print.
        </p>
        <div class="reveal reveal-delay-2 mt-8">
          <a href={WHATSAPP_B2B} class="btn-primary whitespace-nowrap" target="_blank" rel="noopener">
            Register your interest
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
