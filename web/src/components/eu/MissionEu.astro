---
const pillars = [
  {
    t: 'Wake up awareness',
    d: 'An invitation to look at what we use, what we buy and why. To think for yourself instead of following the current.',
  },
  {
    t: 'Break false beliefs',
    d: "What's 'normal' isn't always what's right. We question what the industry takes for granted.",
  },
  {
    t: 'Discard old paradigms',
    d: 'The ones that no longer serve the planet or the people. Without nostalgia and without asking permission.',
  },
];
---

<section id="mission" class="bg-bosque-800 py-24 text-hueso md:py-32">
  <div class="mx-auto max-w-site px-6 md:px-10">
    <p class="eyebrow reveal mb-4 !text-salvia">The mission</p>
    <h2 class="h-display reveal max-w-2xl text-4xl md:text-5xl">
      Our mission goes beyond the product
    </h2>

    <div class="mt-8 max-w-2xl space-y-5 text-[1.05rem] leading-relaxed text-salvia-100/90">
      <p class="reveal">
        We want to show, at an industrial scale, that ethics, ecology and doing things
        with heart don't cost a company its productivity — they give it purpose.
      </p>
      <p class="reveal reveal-delay-1">
        We believe a company is defined as much by what it refuses as by what it creates.
        And that when people identify with its spirit, a conscious company has no limit
        to the real impact it can have on ecological development and on the wellbeing of
        every living thing.
      </p>
    </div>

    <div class="mt-16 grid gap-8 md:grid-cols-3 md:gap-10">
      {
        pillars.map((p, i) => (
          <div class={`reveal border-t border-salvia/40 pt-5 ${i === 1 ? 'reveal-delay-1' : i === 2 ? 'reveal-delay-2' : ''}`}>
            <span class="font-mono text-[0.62rem] uppercase tracking-eyebrow text-salvia">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-2 font-display text-2xl font-bold uppercase tracking-display text-hueso">
              {p.t}
            </h3>
            <p class="mt-3 text-[0.95rem] leading-relaxed text-salvia-100/80">{p.d}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
