---
import { Image } from 'astro:assets';
import nieve from '../../assets/images/terreno-nieve.webp';
import mar from '../../assets/images/terreno-mar.webp';
import yoga from '../../assets/images/terreno-yoga.webp';
import fogon from '../../assets/images/terreno-fogon.webp';
import manos from '../../assets/images/terreno-manos.webp';
import pista from '../../assets/images/terreno-pista.webp';

const fotos = [
  {
    img: nieve,
    alt: 'Skier applying sunscreen on the mountain',
    caption: 'Altitude — where the sun hits twice as hard',
  },
  {
    img: pista,
    alt: 'Skier looking out over the snowy range',
    caption: 'Season — the months that matter',
  },
  {
    img: manos,
    alt: 'Hands opening the Selva Brava tin in the snow',
    caption: '20 grams, zero plastic',
  },
  {
    img: mar,
    alt: 'Selva Brava tin next to a surfboard at the shore',
    caption: 'Sea — water resistant',
  },
  {
    img: yoga,
    alt: 'Yoga practice facing the mountain range',
    caption: 'Movement — body and mountain',
  },
  {
    img: fogon,
    alt: 'Group around the fire in the snow',
    caption: 'Community — the afterwards counts too',
  },
];
---

<section id="terrain" class="bg-niebla py-24 md:py-32">
  <div class="mx-auto max-w-site px-6 md:px-10">
  <p class="eyebrow reveal mb-4">The terrain</p>
  <h2 class="h-display reveal max-w-2xl text-4xl text-carbon md:text-5xl">
    Where what we make gets tested
  </h2>
  <p class="reveal reveal-delay-1 mt-5 max-w-2xl text-[1.05rem] leading-relaxed text-slate-800">
    Snow, salt, wind, altitude. The product is formulated in the lab, but it's proven
    in real conditions — the same ones the people who use it live in.
  </p>

  <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      fotos.map((f, i) => (
        <figure class={`reveal ${i % 3 === 1 ? 'reveal-delay-1' : i % 3 === 2 ? 'reveal-delay-2' : ''}`}>
          <div class="overflow-hidden rounded-sm">
            <Image
              src={f.img}
              alt={f.alt}
              class="aspect-[4/3] w-full object-cover transition-transform duration-500 hover:scale-[1.03]"
              widths={[600, 1200]}
              sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 90vw"
            />
          </div>
          <figcaption class="eyebrow mt-3 !text-slate-400">{f.caption}</figcaption>
        </figure>
      ))
    }
  </div>
  </div>
</section>
