---
import wordmarkCream from '../../assets/logo/wordmark-h-cream.svg';
import { ORIGIN_TAGLINE, FORMULA_LABEL, SPF_LABEL } from '../../config/eu';
---

<header
  id="top"
  class="hero-full relative flex flex-col overflow-hidden text-hueso"
  style="background: radial-gradient(120% 90% at 50% 20%, #7F8D8B 0%, #687978 48%, #566462 100%);"
>
  <!-- Barra superior mínima -->
  <nav class="relative z-20 flex items-center justify-between px-6 py-5 md:px-10">
    <img src={wordmarkCream.src} alt="Selva Brava" class="w-36 md:w-44" />

    <!-- Links desktop -->
    <div class="hidden gap-8 font-display text-sm font-semibold uppercase tracking-[0.12em] md:flex">
      <a href="#product" class="text-hueso/80 transition-colors hover:text-hueso">Product</a>
      <a href="#story" class="text-hueso/80 transition-colors hover:text-hueso">Story</a>
      <a href="#mission" class="text-hueso/80 transition-colors hover:text-hueso">Mission</a>
      <a href="#contact" class="text-hueso/80 transition-colors hover:text-hueso">Contact</a>
    </div>

    <!-- Botón menú mobile -->
    <button
      type="button"
      class="-mr-2 p-2 text-hueso md:hidden"
      data-menu-btn
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="menu-mobile"
    >
      <svg data-menu-open class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      <svg data-menu-close class="hidden h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </nav>

  <!-- Panel menú mobile -->
  <div id="menu-mobile" data-menu-panel class="relative z-10 hidden px-6 md:hidden">
    <div class="flex flex-col border-t border-hueso/15 pt-2 font-display text-base font-semibold uppercase tracking-[0.14em]">
      <a href="#product" data-menu-link class="border-b border-hueso/10 py-3 text-hueso/85 transition-colors hover:text-hueso">Product</a>
      <a href="#story" data-menu-link class="border-b border-hueso/10 py-3 text-hueso/85 transition-colors hover:text-hueso">Story</a>
      <a href="#mission" data-menu-link class="border-b border-hueso/10 py-3 text-hueso/85 transition-colors hover:text-hueso">Mission</a>
      <a href="#contact" data-menu-link class="py-3 text-hueso/85 transition-colors hover:text-hueso">Contact</a>
    </div>
  </div>

  <!-- Qué vendemos, primero. El espíritu, después. -->
  <div class="relative z-10 flex flex-1 flex-col items-center justify-center px-6 text-center">
    <p class="eyebrow mb-6 !text-salvia-200">{ORIGIN_TAGLINE}</p>
    <h1 class="h-display titulo-hero max-w-5xl">
      Sun Protection,<br />
      <span class="text-salvia-300">No Chemicals</span>
    </h1>
    <p class="mt-6 max-w-xl text-base leading-relaxed text-hueso/85 md:text-lg">
      {SPF_LABEL}. {FORMULA_LABEL}, no synthetic filters, no plastic packaging.
      For everyday use and demanding conditions: mountain, sea, altitude.
    </p>
    <a href="#product" class="btn-primary mt-8 !bg-bosque !text-hueso hover:!bg-bosque-600">
      See the product
    </a>
    <p class="mt-10 max-w-md font-display text-sm font-semibold uppercase tracking-[0.18em] text-salvia-300/90 md:text-base">
      We question what's established and think for ourselves… that's where we create from.
    </p>
  </div>

  <!-- Invitación a scroll -->
  <a
    href="#product"
    class="relative z-10 mx-auto mb-8 flex flex-col items-center gap-2 text-hueso/70 transition-colors hover:text-hueso"
    aria-label="Scroll to the product"
  >
    <span class="eyebrow !text-inherit">Discover</span>
    <svg class="chevron-float h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M6 9l6 6 6-6" />
    </svg>
  </a>
</header>

<style>
  /* Alto completo. svh evita el salto por la barra de URL del movil, pero
     no existe en Android/iOS viejos: ahi cae a vh, que funciona igual. */
  .hero-full {
    min-height: 100vh;
    min-height: 100svh;
  }

  /* Respeta el notch en iPhone (el fondo sigue a sangre completa). */
  .hero-full > nav {
    padding-left: max(1.5rem, env(safe-area-inset-left));
    padding-right: max(1.5rem, env(safe-area-inset-right));
  }
  @media (min-width: 768px) {
    .hero-full > nav {
      padding-left: max(2.5rem, env(safe-area-inset-left));
      padding-right: max(2.5rem, env(safe-area-inset-right));
    }
  }

  /* Tipografia fluida en vez de saltos por breakpoint: nunca se desborda,
     ni siquiera si Google Fonts no carga y cae a una fuente mas ancha. */
  .titulo-hero {
    font-size: clamp(2.1rem, 10.5vw, 6.5rem);
    overflow-wrap: break-word;
  }
  @media (min-width: 1024px) {
    .titulo-hero { font-size: clamp(4.5rem, 8vw, 8rem); }
  }

  /* Area tactil de los links: el texto mide 20px de alto, muy poco para
     el dedo. El padding la lleva a ~44px sin mover el diseño. */
  .hero-full nav a,
  .hero-full [data-menu-link] {
    padding-top: 0.7rem;
    padding-bottom: 0.7rem;
    -webkit-tap-highlight-color: transparent;
  }
  .hero-full [data-menu-link] {
    padding-top: 0.85rem;
    padding-bottom: 0.85rem;
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
  const iconOpen = document.querySelector<SVGElement>('[data-menu-open]');
  const iconClose = document.querySelector<SVGElement>('[data-menu-close]');

  if (btn && panel && iconOpen && iconClose) {
    const setOpen = (open: boolean) => {
      panel.classList.toggle('hidden', !open);
      iconOpen.classList.toggle('hidden', open);
      iconClose.classList.toggle('hidden', !open);
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    };
    btn.addEventListener('click', () => setOpen(panel.classList.contains('hidden')));
    document.querySelectorAll('[data-menu-link]').forEach((l) =>
      l.addEventListener('click', () => setOpen(false))
    );
  }
</script>
