---
import LayoutEu from '../../layouts/LayoutEu.astro';
import wordmarkCream from '../../assets/logo/wordmark-h-cream.svg';
import grano from '../../assets/images/grano-carbon.jpg';
import {
  FORMSPREE_ENDPOINT,
  WAITLIST_INCENTIVE,
  WAITLIST_CONFIRMATION,
  ORIGIN_LINE,
  PRICE,
} from '../../config/eu';
---

<LayoutEu
  title="Selva Brava — Launching soon in Europe"
  description="Selva Brava is landing in Europe. Join the waiting list: be the first to get it, plus 15% off at launch."
  canonical="/eu/coming-soon/"
  noindex={true}
>
  <section class="portal">
    <div class="grano" style={`background-image:url(${grano.src});`}></div>

    <div class="contenido">
      <a href="/eu" class="volver">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5" /><path d="M11 18l-6-6 6-6" />
        </svg>
        Back
      </a>

      <img src={wordmarkCream.src} alt="Selva Brava" class="wordmark anim" style="--d:0.05s" />

      <p class="eyebrow-eu anim" style="--d:0.15s">{ORIGIN_LINE}</p>

      <h1 class="titulo anim" style="--d:0.25s">
        Not on sale<br /><span class="acento">just yet</span>
      </h1>

      <div class="bajada anim" style="--d:0.35s">
        <p class="lead">Almost there.</p>
        <p>
          Selva Brava is launching in Europe soon. Be the first to get it — and grab
          15% off at launch.
        </p>
        <p class="apunta">Drop your email 👇</p>
      </div>

      <div class="tarjeta anim" style="--d:0.45s">
        <p class="incentivo">{WAITLIST_INCENTIVE}</p>

        <form class="formulario" data-form action={FORMSPREE_ENDPOINT} method="POST">
          <!-- Honeypot anti-spam: invisible para personas, tentador para bots -->
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="gotcha" />
          <input type="hidden" name="_subject" value="Selva Brava EU — new waiting list signup" />
          <input type="hidden" name="source" value="/eu/coming-soon" />

          <label for="email" class="sr-only">Your email</label>
          <input
            id="email"
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder="your@email.com"
            class="input"
            data-email
          />
          <button type="submit" class="enviar" data-submit>
            <span data-submit-label>Join the list</span>
          </button>
        </form>

        <p class="estado" data-status role="status" aria-live="polite" hidden></p>

        <p class="legal">
          Only your email, only for the launch. No spam, unsubscribe whenever you want.
        </p>
      </div>

      <p class="precio anim" style="--d:0.55s">
        Expected launch price · <strong>{PRICE}</strong> · 20 g tin
      </p>
    </div>
  </section>
</LayoutEu>

<style>
  .portal {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: radial-gradient(115% 90% at 50% 22%, #7F8D8B 0%, #687978 48%, #566462 100%);
    isolation: isolate;
  }
  .grano {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0.35;
    mix-blend-mode: soft-light;
    pointer-events: none;
  }
  .contenido {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.6rem;
    padding: 4.5rem 1.5rem 3.5rem;
    max-width: 40rem;
  }

  .volver {
    position: absolute;
    top: 1.4rem;
    left: 1.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: rgba(250, 248, 241, 0.7);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .volver:hover { color: #FAF8F1; }
  .volver svg { width: 0.9rem; height: 0.9rem; }

  .wordmark { width: clamp(150px, 34vw, 200px); height: auto; }

  .eyebrow-eu {
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 0.64rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: #C5CCBA;
    margin: 0;
  }

  .titulo {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    line-height: 0.92;
    letter-spacing: 0.01em;
    font-size: clamp(2.8rem, 11vw, 5rem);
    color: #FAF8F1;
    margin: 0;
  }
  .acento { color: #C5CCBA; }

  .bajada {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 34rem;
  }
  .bajada p {
    margin: 0;
    font-family: Barlow, sans-serif;
    font-size: 1rem;
    line-height: 1.65;
    color: rgba(250, 248, 241, 0.85);
  }
  .bajada .lead {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: clamp(1.15rem, 4vw, 1.4rem);
    color: #C5CCBA;
  }
  .bajada .apunta {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 600;
    letter-spacing: 0.04em;
    font-size: 1.1rem;
    color: #FAF8F1;
  }

  /* ── Tarjeta del formulario ─────────────────── */
  .tarjeta {
    width: 100%;
    margin-top: 0.6rem;
    padding: 1.9rem 1.5rem 1.5rem;
    background: rgba(250, 248, 241, 0.07);
    border: 1px solid rgba(250, 248, 241, 0.18);
    border-radius: 3px;
    backdrop-filter: blur(3px);
  }
  .incentivo {
    margin: 0 0 1.2rem;
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: clamp(1.05rem, 3.4vw, 1.3rem);
    line-height: 1.25;
    color: #FAF8F1;
  }

  .formulario {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  @media (min-width: 30rem) {
    .formulario { flex-direction: row; }
    .input { flex: 1; }
  }

  .gotcha {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .input {
    font-family: Barlow, sans-serif;
    font-size: 1rem;
    padding: 0.85rem 1rem;
    border-radius: 2px;
    border: 1px solid rgba(250, 248, 241, 0.28);
    background: rgba(250, 248, 241, 0.95);
    color: #1E2523;
    min-width: 0;
  }
  .input::placeholder { color: #7F8D8B; }
  .input:focus-visible {
    outline: 2px solid #C5CCBA;
    outline-offset: 2px;
  }

  .enviar {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.95rem;
    color: #FAF8F1;
    background: #4C6759;
    border: none;
    padding: 0.9rem 1.8rem;
    border-radius: 2px;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.22s ease, transform 0.22s ease;
  }
  .enviar:hover:not(:disabled) { background: #435A4E; transform: translateY(-1px); }
  .enviar:disabled { opacity: 0.6; cursor: default; }
  .enviar:focus-visible { outline: 2px solid #FAF8F1; outline-offset: 3px; }

  .estado {
    margin: 1rem 0 0;
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 1.05rem;
    color: #C5CCBA;
  }
  .estado[data-error] { color: #DDC1B5; }

  /* Estado enviado: el formulario se va, queda la confirmación */
  .tarjeta[data-done] .formulario,
  .tarjeta[data-done] .incentivo,
  .tarjeta[data-done] .legal { display: none; }
  .tarjeta[data-done] .estado { margin: 0; font-size: 1.25rem; }

  .legal {
    margin: 1rem 0 0;
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 0.6rem;
    line-height: 1.6;
    letter-spacing: 0.06em;
    color: rgba(250, 248, 241, 0.55);
  }

  .precio {
    margin: 0;
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 0.64rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: rgba(250, 248, 241, 0.6);
  }
  .precio strong { color: rgba(250, 248, 241, 0.9); }

  .anim {
    opacity: 0;
    transform: translateY(14px);
    animation: rise-cs 0.85s cubic-bezier(0.2, 0.65, 0.2, 1) forwards;
    animation-delay: var(--d, 0s);
  }
  @keyframes rise-cs { to { opacity: 1; transform: none; } }

  @media (prefers-reduced-motion: reduce) {
    .anim { animation: none; opacity: 1; transform: none; }
  }
</style>

<script>
  const CONFIRMATION = "You're on the list — we'll be in touch.";

  const form = document.querySelector<HTMLFormElement>('[data-form]');
  const card = form?.closest<HTMLElement>('.tarjeta');
  const status = document.querySelector<HTMLElement>('[data-status]');
  const button = document.querySelector<HTMLButtonElement>('[data-submit]');
  const label = document.querySelector<HTMLElement>('[data-submit-label]');
  const email = document.querySelector<HTMLInputElement>('[data-email]');

  const show = (msg: string, isError = false) => {
    if (!status) return;
    status.textContent = msg;
    status.hidden = false;
    if (isError) status.setAttribute('data-error', '');
    else status.removeAttribute('data-error');
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;

    button && (button.disabled = true);
    label && (label.textContent = 'Sending…');
    status && (status.hidden = true);

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });

      if (res.ok) {
        // Tracking: alta efectiva en la lista de espera.
        (window as any).sbTrack?.('email_captured', { source: 'eu_coming_soon' });
        card?.setAttribute('data-done', '');
        show(CONFIRMATION);
      } else {
        const data = await res.json().catch(() => null);
        const detail = data?.errors?.[0]?.message;
        show(detail || 'Something went wrong. Try again in a moment.', true);
        button && (button.disabled = false);
        label && (label.textContent = 'Join the list');
      }
    } catch {
      show('Connection failed. Check your network and try again.', true);
      button && (button.disabled = false);
      label && (label.textContent = 'Join the list');
    }
  });

  // Limpia el error apenas el usuario vuelve a escribir
  email?.addEventListener('input', () => {
    if (status && status.hasAttribute('data-error')) status.hidden = true;
  });
</script>
